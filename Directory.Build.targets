<!--
  Repository-level Directory.Build.targets

  Imports the TerminalNinja MSBuild targets for all projects in the solution.
  This is the development-time equivalent of NuGet's buildTransitive/ import:
  NuGet consumers get these targets via the package's build/ folder, ProjectReference
  consumers (in-repo samples, tests, the main library) get them via this Import.

  Both targets files are safe to import everywhere — they no-op in projects that
  don't use them (TerminalNinja.targets only acts on *.xaml files; the Skia targets
  gate themselves on whether TerminalNinja.Skia is actually referenced).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="TerminalNinja/build/TerminalNinja.targets" />
  <Import Project="TerminalNinja.Skia/build/TerminalNinja.Skia.targets" />

</Project>
