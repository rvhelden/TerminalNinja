<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerminalNinja.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalNinja.Generators\TerminalNinja.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Include MSBuild targets in the NuGet package so consuming projects auto-import them -->
  <ItemGroup>
    <None Include="build\TerminalNinja.targets" Pack="true" PackagePath="build\" />
    <None Include="build\TerminalNinja.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- Built-in theme XAML files as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Update="Themes\Dark.xaml" LogicalName="TerminalNinja.Themes.Dark.xaml" />
    <EmbeddedResource Update="Themes\Dracula.xaml" LogicalName="TerminalNinja.Themes.Dracula.xaml" />
    <EmbeddedResource Update="Themes\GruvboxDark.xaml" LogicalName="TerminalNinja.Themes.GruvboxDark.xaml" />
  </ItemGroup>

</Project>
