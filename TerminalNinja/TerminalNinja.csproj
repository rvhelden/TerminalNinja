<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs on public API (~7% gap, closed per-PR). -->
    <!-- CS1574: unresolved cref — pre-existing broken references, closed per-PR. -->
    <!-- Tracked visibly as warnings rather than suppressed so reviewers still see them. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;CS1574</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <Version>1.2.0</Version>
    <PackageId>TerminalNinja</PackageId>
    <Authors>Ronald van Helden</Authors>
    <Company>Wortell</Company>
    <Copyright>Copyright (c) 2026 Ronald van Helden</Copyright>
    <Description>A WPF-inspired terminal UI framework for .NET, built native AOT-first. Declarative XAML layouts, dependency properties, data binding, theming, and 30+ controls.</Description>
    <PackageTags>terminal;tui;console;ui;xaml;wpf;aot;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rvhelden/TerminalNinja</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rvhelden/TerminalNinja.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddGeneratorToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerminalNinja.Tests" />
    <InternalsVisibleTo Include="TerminalNinja.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalNinja.Generators\TerminalNinja.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Include MSBuild targets in the NuGet package so consuming projects auto-import them.
       Forward slashes only: on Linux '\' is a legal filename character rather than a
       directory separator, so a trailing backslash doesn't close the folder and the entry
       no longer matches the exact 'buildTransitive/$(PackageId).targets' path NU5129 wants. -->
  <ItemGroup>
    <None Include="build/TerminalNinja.targets" Pack="true" PackagePath="build/TerminalNinja.targets" />
    <None Include="build/TerminalNinja.targets" Pack="true" PackagePath="buildTransitive/TerminalNinja.targets" />
  </ItemGroup>

  <!-- Include README and icon in the package -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Built-in theme XAML files as embedded resources -->
  <ItemGroup>
    <EmbeddedResource Update="Themes\Dark.xaml" LogicalName="TerminalNinja.Themes.Dark.xaml" />
    <EmbeddedResource Update="Themes\Dracula.xaml" LogicalName="TerminalNinja.Themes.Dracula.xaml" />
    <EmbeddedResource Update="Themes\GruvboxDark.xaml" LogicalName="TerminalNinja.Themes.GruvboxDark.xaml" />
  </ItemGroup>

  <!-- Bundle the source generators DLL as an analyzer in the NuGet package -->
  <Target Name="_AddGeneratorToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\TerminalNinja.Generators\bin\$(Configuration)\netstandard2.0\TerminalNinja.Generators.dll" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
