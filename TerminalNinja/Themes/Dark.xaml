<ResourceDictionary
    xmlns="http://schemas.terminalninja.dev/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         Dark Theme — Default dark terminal color scheme
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Global colors -->
    <Color x:Key="ThemeBackgroundColor">#1e1e1e</Color>
    <Color x:Key="ThemeForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeAccentColor">#569cd6</Color>
    <Color x:Key="ThemeAccentSecondaryColor">#dcdcaa</Color>

    <!-- Border colors -->
    <Color x:Key="ThemeBorderBrushColor">#808080</Color>
    <Color x:Key="ThemeBorderBackgroundColor">#1e1e1e</Color>

    <!-- Button colors -->
    <Color x:Key="ThemeButtonBackgroundColor">#3c3c3c</Color>
    <Color x:Key="ThemeButtonForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeButtonFocusColor">#569cd6</Color>
    <Color x:Key="ThemeButtonHoverColor">#dcdcaa</Color>

    <!-- Text colors -->
    <Color x:Key="ThemeTextForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeTextBackgroundColor">Transparent</Color>

    <!-- Selection colors -->
    <Color x:Key="ThemeSelectedBackgroundColor">#264f78</Color>
    <Color x:Key="ThemeSelectedForegroundColor">#ffffff</Color>

    <!-- Surface colors -->
    <Color x:Key="ThemeSurfaceColor">#252526</Color>
    <Color x:Key="ThemeMutedForegroundColor">#808080</Color>

    <!-- ProgressBar colors -->
    <Color x:Key="ThemeProgressForegroundColor">#569cd6</Color>
    <Color x:Key="ThemeProgressBackgroundColor">Transparent</Color>
    <Color x:Key="ThemeProgressTrackColor">#3c3c3c</Color>

    <!-- Dialog colors -->
    <Color x:Key="ThemeDialogBackgroundColor">#252526</Color>
    <Color x:Key="ThemeDialogForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeDialogBorderColor">#569cd6</Color>

    <!-- TabControl colors -->
    <Color x:Key="ThemeTabControlBackgroundColor">#1e1e1e</Color>
    <Color x:Key="ThemeTabControlForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeTabControlBorderColor">#808080</Color>
    <Color x:Key="ThemeTabSelectedBackgroundColor">#1e1e1e</Color>
    <Color x:Key="ThemeTabSelectedForegroundColor">#ffffff</Color>
    <Color x:Key="ThemeTabUnselectedForegroundColor">#808080</Color>

    <!-- TreeView colors -->
    <Color x:Key="ThemeTreeViewBackgroundColor">#1e1e1e</Color>
    <Color x:Key="ThemeTreeViewForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeTreeViewExpandIndicatorColor">#569cd6</Color>

    <!-- ListView colors -->
    <Color x:Key="ThemeListViewBackgroundColor">#1e1e1e</Color>
    <Color x:Key="ThemeListViewForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeListViewHeaderBackgroundColor">#252526</Color>
    <Color x:Key="ThemeListViewHeaderForegroundColor">#ffffff</Color>
    <Color x:Key="ThemeListViewGridLineColor">#3c3c3c</Color>

    <!-- ColorPicker colors -->
    <Color x:Key="ThemeColorPickerBackgroundColor">#3c3c3c</Color>
    <Color x:Key="ThemeColorPickerForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeColorPickerFocusColor">#569cd6</Color>
    <Color x:Key="ThemeColorPickerHoverColor">#dcdcaa</Color>

    <!-- Picker colors -->
    <Color x:Key="ThemePickerBackgroundColor">#3c3c3c</Color>
    <Color x:Key="ThemePickerForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemePickerFocusColor">#569cd6</Color>
    <Color x:Key="ThemePickerHoverColor">#dcdcaa</Color>
    <Color x:Key="ThemePickerHighlightColor">#569cd6</Color>

    <!-- TextBox colors -->
    <Color x:Key="ThemeTextBoxBackgroundColor">#3c3c3c</Color>
    <Color x:Key="ThemeTextBoxForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeTextBoxFocusColor">#569cd6</Color>
    <Color x:Key="ThemeTextBoxHoverColor">#dcdcaa</Color>
    <Color x:Key="ThemeTextBoxPlaceholderColor">#808080</Color>

    <!-- ScrollViewer colors -->
    <Color x:Key="ThemeScrollIndicatorColor">#808080</Color>

    <!-- CheckBox / RadioButton colors -->
    <Color x:Key="ThemeCheckBoxForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeCheckBoxFocusColor">#569cd6</Color>
    <Color x:Key="ThemeCheckBoxHoverColor">#dcdcaa</Color>

    <!-- ComboBox colors -->
    <Color x:Key="ThemeComboBoxBackgroundColor">#3c3c3c</Color>
    <Color x:Key="ThemeComboBoxForegroundColor">#d4d4d4</Color>
    <Color x:Key="ThemeComboBoxFocusColor">#569cd6</Color>
    <Color x:Key="ThemeComboBoxHoverColor">#dcdcaa</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Implicit Styles — applied automatically by control type
         ═══════════════════════════════════════════════════════════════ -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextForegroundColor}" />
        <Setter Property="Background" Value="{StaticResource ThemeTextBackgroundColor}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ThemeButtonBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeButtonForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeButtonFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemeButtonHoverColor}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrushColor}" />
        <Setter Property="Background" Value="{StaticResource ThemeBorderBackgroundColor}" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource ThemeBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeForegroundColor}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource ThemeBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeAccentColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
        <Setter Property="ShowSelectionIndicator" Value="True" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource ThemeBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeForegroundColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
        <Setter Property="ShowSelectionIndicator" Value="True" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource ThemeProgressForegroundColor}" />
        <Setter Property="Background" Value="{StaticResource ThemeProgressBackgroundColor}" />
        <Setter Property="TrackForeground" Value="{StaticResource ThemeProgressTrackColor}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ThemeTextBoxBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextBoxForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeTextBoxFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemeTextBoxHoverColor}" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource ThemeTextBoxPlaceholderColor}" />
        <Setter Property="SelectionBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectionForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="{StaticResource ThemeBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeForegroundColor}" />
        <Setter Property="ScrollIndicatorForeground" Value="{StaticResource ThemeScrollIndicatorColor}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ThemeCheckBoxForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeCheckBoxFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemeCheckBoxHoverColor}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ThemeCheckBoxForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeCheckBoxFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemeCheckBoxHoverColor}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ThemeComboBoxBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeComboBoxForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeComboBoxFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemeComboBoxHoverColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource ThemeBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeForegroundColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource ThemeTabControlBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTabControlForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeAccentColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeTabSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeTabSelectedForegroundColor}" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource ThemeTabControlBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTabControlForegroundColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeTabSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeTabSelectedForegroundColor}" />
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource ThemeTreeViewBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTreeViewForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeAccentColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Background" Value="{StaticResource ThemeTreeViewBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTreeViewForegroundColor}" />
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource ThemeListViewBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeListViewForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeAccentColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
        <Setter Property="HeaderBackground" Value="{StaticResource ThemeListViewHeaderBackgroundColor}" />
        <Setter Property="HeaderForeground" Value="{StaticResource ThemeListViewHeaderForegroundColor}" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="{StaticResource ThemeListViewBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeListViewForegroundColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource ThemeListViewBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeListViewForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeAccentColor}" />
        <Setter Property="SelectedBackground" Value="{StaticResource ThemeSelectedBackgroundColor}" />
        <Setter Property="SelectedForeground" Value="{StaticResource ThemeSelectedForegroundColor}" />
        <Setter Property="HeaderBackground" Value="{StaticResource ThemeListViewHeaderBackgroundColor}" />
        <Setter Property="HeaderForeground" Value="{StaticResource ThemeListViewHeaderForegroundColor}" />
    </Style>

    <Style TargetType="ColorPicker">
        <Setter Property="Background" Value="{StaticResource ThemeColorPickerBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeColorPickerForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemeColorPickerFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemeColorPickerHoverColor}" />
    </Style>

    <Style TargetType="NumberPicker">
        <Setter Property="Background" Value="{StaticResource ThemePickerBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemePickerForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemePickerFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemePickerHoverColor}" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource ThemePickerBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemePickerForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemePickerFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemePickerHoverColor}" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="Background" Value="{StaticResource ThemePickerBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemePickerForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemePickerFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemePickerHoverColor}" />
    </Style>

    <Style TargetType="DateTimePicker">
        <Setter Property="Background" Value="{StaticResource ThemePickerBackgroundColor}" />
        <Setter Property="Foreground" Value="{StaticResource ThemePickerForegroundColor}" />
        <Setter Property="FocusColor" Value="{StaticResource ThemePickerFocusColor}" />
        <Setter Property="HoverColor" Value="{StaticResource ThemePickerHoverColor}" />
    </Style>

</ResourceDictionary>
