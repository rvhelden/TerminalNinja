<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;CS1574</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalNinja\TerminalNinja.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Windowing is hand-rolled SDL3 P/Invoke via [LibraryImport] — see Sdl3.cs.
      The AOT spike (samples/SkiaSpike) proved this stack publishes with zero
      trim/AOT warnings, where Silk.NET.Windowing 2.x produced seven.

      The native SDL3 binary (SDL3.dll on Windows, libSDL3.so.0 on Linux) must
      be on the dynamic-library search path. Packaging that as a NuGet runtime
      asset is a separate task; for now consumers either ship it themselves
      or rely on a system install.
    -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.1" />

    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerminalNinja.Tests" />
  </ItemGroup>

  <!--
    Ship the MSBuild .targets file in the NuGet package so consumers automatically get
    the SDL3 native-binary resolution / copy-to-output behavior. NuGet auto-imports any
    .targets file under build/<PackageId>.targets when the package is referenced.
    Including the same file under buildTransitive/ makes it apply through transitive
    references too (e.g. an app that references a library that references TerminalNinja.Skia).
  -->
  <ItemGroup>
    <None Include="build\TerminalNinja.Skia.targets" Pack="true" PackagePath="build\" />
    <None Include="build\TerminalNinja.Skia.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
