<Border xmlns="http://schemas.terminalninja.dev/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dataGrid="clr-namespace:Sample.Samples.DataGrid"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=dataGrid:DataGridViewModel}"
        BorderStyle="Rounded">
    <StackPanel Orientation="Vertical">
        <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1"
                   Text=" DataGrid" Padding="2,0,0,0" />
        <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="2"
                   Text="  Read-only multi-column grid with sorting indicators and row selection."
                   Padding="2,0,0,0" VerticalTextAlignment="Center" />
        <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Text="" />

        <DataGrid StackPanel.SizeMode="Stretch" TabIndex="0" ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridColumn Header="Id" DisplayMemberBinding="Id" />
                <DataGridColumn Header="Name" DisplayMemberBinding="Name" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Border>
