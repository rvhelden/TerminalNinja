<Window xmlns="http://schemas.terminalninja.dev/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sample="clr-namespace:Sample"
        xmlns:data="clr-namespace:TerminalNinja.Xaml.Data;assembly=TerminalNinja"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance sample:DemoViewModel}"
        Title="TerminalNinja Demo">

    <!-- Window-level Resources -->
    <Window.Resources>
        <data:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <sample:PerformanceConverter x:Key="PerformanceConverter" />
    </Window.Resources>

    <!-- Rows: Header=5, Toolbar=5, Content=*, StatusBar=3 -->
    <!-- Columns: Content=*, ActivityLog=35, Menu=24 -->
    <Grid Rows="5 5 * 3" Columns="* 35 24">
        <!-- Header spanning all 3 columns -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" BorderStyle="Double">
            <TextBlock x:Name="HeaderTextBlock" Text="{Binding HeaderText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
        </Border>

        <!-- Toolbar spanning all 3 columns -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderStyle="Single">
            <StackPanel Orientation="Horizontal">
                <Border StackPanel.SizeMode="Auto" Width="2" />

                <Button x:Name="NewButton" StackPanel.SizeMode="Auto" Text="New" Width="12" Height="3" TabIndex="0" Command="{Binding NewCommand}" />
                <Button x:Name="GcCollectButton" Text="GC Collect" Command="{Binding GCCollect}" />
                <Button x:Name="OpenButton" StackPanel.SizeMode="Auto" Text="Open" Width="12" Height="3" TabIndex="1" Command="{Binding Path=OpenCommand}" />
                <Button x:Name="SaveButton" StackPanel.SizeMode="Auto" Text="Save" Width="12" Height="3" TabIndex="2" Command="{Binding Path=SaveCommand}" />
                <Button x:Name="DialogButton" StackPanel.SizeMode="Auto" Text="Dialog" Width="12" Height="3" TabIndex="3" Command="{Binding ShowDialogCommand}" />
            </StackPanel>
        </Border>

        <!-- Content area: column 0, row 2 -->
        <Border Grid.Row="2" Grid.Column="0" BorderStyle="Rounded">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="ContentTextBlock" StackPanel.SizeMode="Fixed" StackPanel.FixedSize="5" Text="{Binding Path=ContentText}" 
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextWrapping="Wrap" Padding="4,1,4,0" />

                <!-- ProgressBar Demos -->
                <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Text=" Progress Bars" Padding="2,0,0,0" />

                <!-- Bound determinate progress bar with percentage -->
                <ProgressBar StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Value="{Binding ProgressValue}" ShowPercentage="True" />
                <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Text="" /> 
                
                <!-- Indeterminate progress bar -->
                <ProgressBar StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" IsIndeterminate="True" />
                <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Text="" />

                <!-- Static progress bars at different levels -->
                <ProgressBar StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Value="25" BarCharacter="=" TrackCharacter="-" />
                <ProgressBar StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Value="75" />

                <TextBlock StackPanel.SizeMode="Stretch" Text="" />
            </StackPanel>
        </Border>

        <!-- Activity Log: column 1, row 2 -->
        <sample:ActivityLogControl Grid.Row="2" Grid.Column="1" x:Name="ActivityLog" ItemsSource="{Binding LogEntries}" />

        <!-- Menu: column 2, row 2 -->
        <Border Grid.Row="2" Grid.Column="2" BorderStyle="Rounded">
            <StackPanel Orientation="Vertical">
                <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" Text=" Menu" />
                <ListBox StackPanel.SizeMode="Stretch" x:Name="MenuListBox" ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMenuItem}" TabIndex="4" />
            </StackPanel>
        </Border>

        <!-- Status Bar spanning all 3 columns -->
        <Border Grid.Row="3" Grid.ColumnSpan="3" BorderStyle="Single">
            <StackPanel Orientation="Horizontal">

                <TextBlock StackPanel.SizeMode="Stretch" x:Name="StatusTextBlock"
                           Text="{Binding Path=StatusText}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="MemoryTextBlock"
                           Text="{Binding MemoryUsageMB, Converter={StaticResource PerformanceConverter}, ConverterParameter=Memory}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="2,0,2,0" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="CpuTextBlock"
                           Text="{Binding CpuUsagePercent, Converter={StaticResource PerformanceConverter}, ConverterParameter=Cpu}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="2,0,2,0" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="FpsLabelTextBlock"
                           Text="FPS:"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="2,0,0,0" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="CurrentFpsTextBlock"
                           Text="{Binding CurrentFps, Converter={StaticResource PerformanceConverter}, ConverterParameter=CurrentFps}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="0,0,0,0" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="FpsSeparatorTextBlock"
                           Text="/"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="0,0,0,0" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="TargetFpsTextBlock"
                           Text="{Binding TargetFps, Converter={StaticResource PerformanceConverter}, ConverterParameter=TargetFps}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="0,0,2,0" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="TtfrTextBlock"
                           Text="{Binding TimeToFirstRenderMs, Converter={StaticResource PerformanceConverter}, ConverterParameter=TTFR}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="2,0,2,0" />

                <TextBlock StackPanel.SizeMode="Auto" x:Name="TimeTextBlock"
                           Text="{Binding CurrentTime, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=HH:mm:ss}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           Padding="2,0,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</Window>