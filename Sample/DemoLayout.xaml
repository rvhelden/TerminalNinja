<Window xmlns="http://schemas.terminalninja.dev/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sample="clr-namespace:Sample"
        xmlns:data="clr-namespace:TerminalNinja.Xaml.Data;assembly=TerminalNinja"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance sample:DemoViewModel}"
        Title="TerminalNinja Demo">
    
    <!-- Window-level Resources -->
    <Window.Resources>
        <Color x:Key="HeaderBackground">#1E1E50</Color>
        <Color x:Key="ToolbarBackground">#19192D</Color>
        <Color x:Key="ContentBackground">#FF0000</Color>
        <Color x:Key="StatusBackground">#282828</Color>
        <Color x:Key="ButtonBackground">#141414</Color>
        <Color x:Key="AccentColor">Cyan</Color>
        <Color x:Key="HighlightColor">Yellow</Color>
        <data:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
    </Window.Resources>
    
    <StackPanel Orientation="Vertical">
        
        <!-- Header with data binding -->
        <Rectangle StackPanel.SizeMode="Fixed" StackPanel.FixedSize="5"
                   BackgroundColor="{StaticResource HeaderBackground}"
                   ForegroundColor="{StaticResource AccentColor}"
                   Border="Double">
            <Label x:Name="headerLabel"
                   Text="{Binding Path=HeaderText}"
                   ForegroundColor="{StaticResource AccentColor}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Rectangle>
        
        <!-- Toolbar with command binding -->
        <Rectangle StackPanel.SizeMode="Fixed" StackPanel.FixedSize="5"
                   BackgroundColor="{StaticResource ToolbarBackground}"
                   Border="Single">
            <StackPanel Orientation="Horizontal">
                <Rectangle StackPanel.SizeMode="Auto"
                           Width="2"
                           BackgroundColor="{StaticResource ToolbarBackground}" />
                
                <Button x:Name="newButton"
                        StackPanel.SizeMode="Auto"
                        Text="New"
                        Width="12"
                        Height="3"
                        TabIndex="0"
                        FocusColor="{StaticResource AccentColor}"
                        HoverColor="{StaticResource HighlightColor}"
                        ForegroundColor="White"
                        BackgroundColor="{StaticResource ButtonBackground}"
                        Command="{Binding NewCommand}" />
                
                <Button x:Name="openButton"
                        StackPanel.SizeMode="Auto"
                        Text="Open"
                        Width="12"
                        Height="3"
                        TabIndex="1"
                        FocusColor="{StaticResource AccentColor}"
                        HoverColor="{StaticResource HighlightColor}"
                        ForegroundColor="White"
                        BackgroundColor="{StaticResource ButtonBackground}"
                        Command="{Binding Path=OpenCommand}" />
                
                <Button x:Name="saveButton"
                        StackPanel.SizeMode="Auto"
                        Text="Save"
                        Width="12"
                        Height="3"
                        TabIndex="2"
                        FocusColor="{StaticResource AccentColor}"
                        HoverColor="{StaticResource HighlightColor}"
                        ForegroundColor="White"
                        BackgroundColor="{StaticResource ButtonBackground}"
                        Command="{Binding Path=SaveCommand}" />
                
                <Rectangle StackPanel.SizeMode="Stretch" BackgroundColor="{StaticResource ToolbarBackground}" />
            </StackPanel>
        </Rectangle>
        
        <!-- Content Area with data binding -->
        <Rectangle StackPanel.SizeMode="Stretch"
                   BackgroundColor="{StaticResource ContentBackground}"
                   Border="Rounded">
            <Label x:Name="contentLabel"
                   Text="{Binding Path=ContentText}"
                   ForegroundColor="White"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextWrapping="Wrap"
                   Padding="4,2,4,2" />
        </Rectangle>
        
        <!-- Status Bar with data binding -->
        <Rectangle StackPanel.SizeMode="Fixed" StackPanel.FixedSize="3"
                   BackgroundColor="{StaticResource StatusBackground}"
                   ForegroundColor="{StaticResource HighlightColor}"
                   Border="Single">
            <StackPanel Orientation="Horizontal">
                
            <Label StackPanel.SizeMode="Stretch" x:Name="statusLabel"
                   Text="{Binding Path=StatusText}"
                   ForegroundColor="{StaticResource HighlightColor}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
            
            <Label StackPanel.SizeMode="Auto" x:Name="timeLabel"
                   Text="{Binding CurrentTime, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter=HH:mm:ss}"
                   ForegroundColor="{StaticResource HighlightColor}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
            </StackPanel>
        </Rectangle>
        
    </StackPanel>
</Window>
