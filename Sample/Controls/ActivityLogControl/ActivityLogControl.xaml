<UserControl
    xmlns="http://schemas.terminalninja.dev/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sample="clr-namespace:Sample;assembly=Sample"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:Class="Sample.ActivityLogControl">

    <UserControl.Resources>
        <DataTemplate x:Key="LogEntryTemplate" DataType="sample:LogEntry">
            <StackPanel Orientation="Horizontal">
                <FontIcon StackPanel.SizeMode="Auto" Symbol="Check" Foreground="Green" />
                <TextBlock StackPanel.SizeMode="Stretch" TextWrapping="Wrap">
                    <Run Text="{Binding Time}" />
                    <![CDATA[: ]]>
                    <Run Text="{Binding Message}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderStyle="Rounded">
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="TitleText" Text=" Activity Log" StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1" />
            <ItemsControl x:Name="LogItemsControl" StackPanel.SizeMode="Stretch" ItemTemplate="{StaticResource LogEntryTemplate}"
                          ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={system:Type sample:ActivityLogControl}}}" />
        </StackPanel>
    </Border>
</UserControl>