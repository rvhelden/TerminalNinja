<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <RootNamespace>SkiaTerminal</RootNamespace>
        <AssemblyName>SkiaTerminal</AssemblyName>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <!--
            Default to the host RID for plain `dotnet build` so TerminalNinja.Skia.targets
            can probe runtimes/<rid>/native/ for SDL3.dll. Override on the command line
            with `dotnet build -r <rid>` for cross-platform builds.
        -->
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
        <!--
            Standalone demo that hosts TerminalView inside a SkiaApplication window:
            spawns the platform shell through ITerminalBackend (ConPTY on Windows,
            forkpty on Unix once that lands) and pipes its output into a GPU-rendered
            terminal. UI is declared in ShellLayout.xaml; ShellViewModel owns the
            backend lifetime and the TerminalView the layout binds to.
        -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\TerminalNinja.Skia\TerminalNinja.Skia.csproj" />
        <ProjectReference Include="..\..\TerminalNinja.Terminal\TerminalNinja.Terminal.csproj" />
        <ProjectReference Include="..\..\TerminalNinja.Generators\TerminalNinja.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
