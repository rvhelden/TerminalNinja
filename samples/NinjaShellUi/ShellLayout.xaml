<Border xmlns="http://schemas.terminalninja.dev/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:NinjaShellUi"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=s:ShellViewModel}"
        Background="#1E1E2E"
        BorderBrush="#CDD6F4">
    <Grid Rows="* 1" Columns="*">
        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <!-- Files panel (left). Visibility="Collapsed" yields its width back to the
                 stretching center cell now that StackPanel honors UIElement.Visibility. -->
            <Border StackPanel.SizeMode="Fixed" StackPanel.FixedSize="32"
                    Visibility="{Binding FilesPanelVisibility}"
                    BorderStyle="Single"
                    BorderBrush="#45475A"
                    Padding="1,0,1,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1"
                               Text=" Files"
                               Foreground="#F9E2AF"
                               TextDecorations="Bold" />
                    <TextBlock StackPanel.SizeMode="Stretch"
                               Text="{Binding FilesText}"
                               Foreground="#CDD6F4"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>

            <!-- REPL (center) — fills the remaining horizontal space -->
            <Border StackPanel.SizeMode="Stretch"
                    BorderStyle="Single"
                    BorderBrush="#45475A">
                <ContentControl Content="{Binding Repl}" />
            </Border>

            <!-- Env + scope (right). The wrapper Border collapses when both inner panels are
                 collapsed (RightPanelVisibility is wired in the VM). Inner Visibility bindings
                 toggle env / scope independently. -->
            <Border StackPanel.SizeMode="Fixed" StackPanel.FixedSize="56"
                    Visibility="{Binding RightPanelVisibility}"
                    BorderStyle="Single"
                    BorderBrush="#45475A"
                    Padding="1,0,1,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1"
                               Visibility="{Binding EnvPanelVisibility}"
                               Text=" Environment"
                               Foreground="#F9E2AF"
                               TextDecorations="Bold" />
                    <ContentControl StackPanel.SizeMode="Fixed" StackPanel.FixedSize="14"
                                    Visibility="{Binding EnvPanelVisibility}"
                                    Content="{Binding EnvList}" />
                    <TextBlock StackPanel.SizeMode="Fixed" StackPanel.FixedSize="1"
                               Visibility="{Binding ScopePanelVisibility}"
                               Text=" Scope"
                               Foreground="#F9E2AF"
                               TextDecorations="Bold" />
                    <ContentControl StackPanel.SizeMode="Stretch"
                                    Visibility="{Binding ScopePanelVisibility}"
                                    Content="{Binding ScopeList}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer with shortcut hints -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="{Binding ShortcutHint}"
                   Foreground="#7F849C"
                   Background="#181825"
                   HorizontalTextAlignment="Center" />
    </Grid>
</Border>
