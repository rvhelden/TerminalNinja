<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <RootNamespace>SkiaHello</RootNamespace>
        <AssemblyName>SkiaHello</AssemblyName>
        <!--
            Minimal AOT canary for TerminalNinja.Skia: opens an SDL3+Skia window,
            draws a styled Border via the cell pipeline, exits on Escape.
            Not in TerminalNinja.slnx by design — the spike folder houses canaries.
        -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\TerminalNinja.Skia\TerminalNinja.Skia.csproj" />
    </ItemGroup>

</Project>
