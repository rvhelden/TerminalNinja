<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <RootNamespace>SkiaSpike</RootNamespace>
        <AssemblyName>SkiaSpike</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!--
            Spike project: standalone AOT canary for SkiaSharp + HarfBuzz + SDL3.
            Deliberately NOT added to TerminalNinja.slnx — its only job is to prove the
            chosen packages publish cleanly under Native AOT for win-x64 and linux-x64
            before we commit to the SkiaCellSink in the main library.

            DO NOT add SkiaSharp.Views.* packages — they are known trim-unsafe.

            Windowing is hand-rolled SDL3 P/Invoke via [LibraryImport] (source-generated,
            AOT-friendly). Silk.NET 2.x was tried and dropped — its windowing layer has
            IL2072 / IL3000 / IL3002 warnings rooted in reflection-based platform
            discovery and Assembly.Location-based native asset loading, both of which
            are AOT-incompatible.

            Native SDL3 binary (SDL3.dll on Windows, libSDL3.so.0 on Linux) must be on
            the dynamic-library search path. For now, that's a user responsibility;
            packaging is a separate problem the production TerminalNinja.Skia project
            will solve.
        -->
    </PropertyGroup>

    <ItemGroup>
        <!-- Skia (raw, no Views) + HarfBuzz shaping. These are the entire package surface. -->
        <PackageReference Include="SkiaSharp" Version="3.119.0" />
        <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
        <PackageReference Include="HarfBuzzSharp" Version="8.3.1.1" />

        <!-- Native assets for Skia / HarfBuzz on both runtimes. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.1" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.1" />
    </ItemGroup>

</Project>
