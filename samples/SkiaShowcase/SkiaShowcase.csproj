<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <RootNamespace>SkiaShowcase</RootNamespace>
        <AssemblyName>SkiaShowcase</AssemblyName>
        <!--
            Richer end-to-end sample for TerminalNinja.Skia. Where SkiaHello demonstrates
            the minimum (one Border + TextBlock), this one exercises multiple focusable
            controls, theming, tab navigation, and Application.Current integration — the
            surface most apps will actually use.

            Not in TerminalNinja.slnx by design; samples/ is the canary folder.
        -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\TerminalNinja.Skia\TerminalNinja.Skia.csproj" />
    </ItemGroup>

</Project>
